{
  "name": "wallet-cash-in",
  "version": "0.0.1",
  "description": "Wallet Cash-In service: idempotent top ups through an external payment provider (NestJS, DDD, CQRS, MongoDB)",
  "author": "Kedein Rodriguez",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "oxlint -c .oxlintrc.json --deny-warnings src test",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "infra:up": "docker compose up -d --wait mongo",
    "infra:down": "docker compose down",
    "seed": "docker compose exec -T mongo mongosh --quiet wallet --eval \"$(cat scripts/seed.mongodb.js)\"",
    "prepare": "husky",
    "start:dev:pretty": "nest start --watch | scripts/pretty-logs.sh",
    "logs": "docker compose logs -f --no-log-prefix api | scripts/pretty-logs.sh"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/cqrs": "^12.1.0",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/swagger": "^12.0.2",
    "@nestjs/throttler": "^6.7.1",
    "@scalar/nestjs-api-reference": "^1.2.27",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "mongodb": "^7.7.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@swc/core": "^1.16.13",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "husky": "^9.1.7",
    "oxlint": "^1.58.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "typescript": "^6.0.2",
    "unplugin-swc": "^2.0.0",
    "vitest": "^4.1.2"
  },
  "engines": {
    "node": ">=24",
    "npm": ">=11"
  }
}
