NODE_ENV=development
PORT=3000
# directConnection lets the host reach the single node replica set started by docker compose
MONGO_URI=mongodb://localhost:27017/?replicaSet=rs0&directConnection=true
MONGO_DB=wallet
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100
CORS_ALLOWED_ORIGIN=*
# Defaults to false when NODE_ENV=production
SWAGGER_ENABLED=true
MONGO_SERVER_SELECTION_TIMEOUT_MS=5000
HEALTH_CHECK_TIMEOUT_MS=800
PROVIDER_TIMEOUT_MS=3000
PROVIDER_MAX_ATTEMPTS=3
RETRY_BASE_DELAY_MS=50
RETRY_MAX_DELAY_MS=1000
OPERATION_LEASE_MS=15000
SETTLEMENT_MAX_ATTEMPTS=5
WEBHOOK_SIGNING_SECRET=dev-only-webhook-signing-secret
WEBHOOK_TOLERANCE_SECONDS=300
RECONCILER_ENABLED=true
RECONCILER_INTERVAL_MS=15000
RECONCILER_MIN_AGE_MS=30000
RECONCILER_BATCH_SIZE=20
RECONCILER_MAX_PROVIDER_CALLS=10
